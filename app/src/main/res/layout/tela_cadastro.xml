<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="8dp"
            android:paddingBottom="16dp"
            android:text="@string/titulo_flashcard"
            android:textAlignment="center"
            android:textColor="@color/azul_escuro"
            android:textSize="24sp" />

        <TextView
            android:id="@+id/tvInfo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingBottom="12dp"
            android:textSize="13sp"
            android:visibility="gone" />

        <EditText
            android:id="@+id/etPalavra"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/hint_palavra"
            android:inputType="text"
            android:maxLines="1"
            android:textSize="18sp" />

        <EditText
            android:id="@+id/etTraducao"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/hint_traducao"
            android:inputType="text"
            android:maxLines="1"
            android:textSize="18sp" />

        <EditText
            android:id="@+id/etIdioma"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/hint_idioma"
            android:inputType="text"
            android:maxLines="1"
            android:textSize="18sp" />

        <EditText
            android:id="@+id/etFrase"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="top|start"
            android:hint="@string/hint_frase"
            android:inputType="textMultiLine|textCapSentences"
            android:minLines="3"
            android:textSize="18sp" />

        <!-- Explica a regra de negócio para o usuário -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/fundo_aviso"
            android:padding="12dp"
            android:layout_marginTop="8dp"
            android:text="@string/aviso_regra"
            android:textSize="13sp" />

        <Button
            android:id="@+id/btnSave"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:onClick="salvarFlashcard"
            android:text="@string/salvar"
            android:textSize="18sp" />

        <Button
            android:id="@+id/btnDelete"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:backgroundTint="@color/vermelho"
            android:onClick="excluirFlashcard"
            android:text="@string/excluir"
            android:textSize="18sp"
            android:visibility="gone" />

    </LinearLayout>

</ScrollView>
