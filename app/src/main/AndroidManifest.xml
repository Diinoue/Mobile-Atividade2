<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Lexicards">

        <activity
            android:name=".controlador.TelaPrincipal"
            android:exported="true"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".controlador.TelaCadastro"
            android:exported="false"
            android:label="@string/titulo_flashcard"
            android:parentActivityName=".controlador.TelaPrincipal" />

        <activity
            android:name=".controlador.TelaEstudo"
            android:exported="false"
            android:label="@string/titulo_estudar"
            android:parentActivityName=".controlador.TelaPrincipal" />

    </application>

</manifest>
